rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only these accounts can sign in and change data
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['REPLACE_WITH_ADMIN_EMAIL'];
    }

    // Rate settings: anyone can read (the quote page needs them), admins write
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Business records are private: admins only
    match /customers/{docId} {
      allow read, write: if isAdmin();
    }
    match /addresses/{docId} {
      allow read, write: if isAdmin();
    }
    match /jobs/{docId} {
      allow read, write: if isAdmin();
    }
    match /invoices/{docId} {
      allow read, write: if isAdmin();
    }

    // Everything else is locked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
